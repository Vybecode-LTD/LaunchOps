# VybeCod.ing Launch Ops — Environment Variables
# Copy to .env and fill in your values. On Railway, set these as service variables.

# Debug mode serves API docs at /docs and tolerates a weak JWT_SECRET. Never enable it in production.
DEBUG=false

# Auth: sign-in tokens are signed with this. The app refuses to start without a random value of at
# least 32 characters (unless DEBUG=true). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Sign-in tokens last ACCESS_TOKEN_MINUTES; the browser renews them with a refresh token kept for REFRESH_TOKEN_DAYS.
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30

# The first account created becomes the platform admin. On a deployment anyone can reach, set this to your
# address before it goes live, so only you can create that account.
# ADMIN_EMAIL=you@example.com

# Email LaunchOps sends itself: password reset links and invitations. Leave unset to send nothing
# (administrators can then create reset links, and owners share invitation links themselves).
# APP_URL=https://launchops.run
# MAIL_SMTP_HOST=smtp.postmarkapp.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM_EMAIL=no-reply@launchops.run
# MAIL_FROM_NAME=LaunchOps

# Other sites allowed to call the API, comma-separated. Leave empty when the frontend is served by
# this app (production) or through the Vite dev proxy (local development).
CORS_ORIGINS=

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model for every operation except the deep reports, and the model for market analysis and pricing.
# Leave both unset to use the defaults shown.
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_REPORT_MODEL=claude-opus-5

# Encrypts secrets stored in the database, such as each project's SMTP password. Required unless
# DEBUG=true. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the new key first and keep the old one after it, comma-separated, e.g. NEW,OLD.
# Saved passwords are readable with either key; remove the old key once passwords have been re-entered.
FIELD_ENCRYPTION_KEY=

# PostgreSQL (Railway provides this as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:port/database
# Local dev / CI Postgres without SSL: an sslmode in the URL is honored as-is
# DATABASE_URL=postgresql://postgres@localhost:5432/launchops?sslmode=disable

# Limits (defaults shown)
# RATE_LIMIT_ENABLED=true        sign-in, registration and AI operation rate limits
# AI_OPERATIONS_PER_HOUR=60      per account
# MAX_CONCURRENT_TASKS=5         background operations running at once, per account
# MAX_EMAILS_PER_DAY=20          Outbox sends per account in any 24 hours; 0 switches sending off
# DEFAULT_MONTHLY_AI_BUDGET_USD=25   spending cap for any organisation that has not set its own.
#                                Registration creates organisations without a budget, and every
#                                deployment bills AI to one API key, so without this anyone who
#                                signs up could spend on that key without limit. An organisation's
#                                own budget always wins. 0 means no default cap.
