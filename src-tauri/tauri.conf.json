{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "VybeCoding LaunchOps",
  "version": "1.0.0",
  "identifier": "com.vybecoding.launchops",
  "build": {
    "frontendDist": "https://launchops.run"
  },
  "app": {
    "windows": [
      {
        "title": "LaunchOps",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://launchops.run; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://launchops.run"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
